# Port the HTTP server listens on.
PORT=3000

# Bearer token required on every mutating/admin endpoint (POST /trigger, GET
# /briefings). Generate a long random value — e.g. `openssl rand -hex 32` —
# and never commit the real value.
BACKEND_API_KEY=replace-with-a-long-random-secret

# Cron expression (server local time) for the daily briefing run across the
# whole team. Default: 8:00 AM, Monday-Friday.
BRIEFING_CRON=0 8 * * 1-5

# Path to the team config file (see config/team.example.json for the shape).
# This file holds real CRM tokens — keep it out of git.
TEAM_CONFIG_PATH=./config/team.json

# --- Slack (optional: only needed if any salesperson has delivery.slack
# with a userId set instead of a per-person webhookUrl) ---
SLACK_BOT_TOKEN=

# --- Email (optional: only needed if any salesperson has delivery.email
# enabled) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Project Jarvis <jarvis@yourcompany.com>"
